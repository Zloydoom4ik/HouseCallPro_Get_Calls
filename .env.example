# Скопируй в .env и заполни. .env в git не коммитится.
HCP_BASE_URL=https://pro.housecallpro.com
HCP_COOKIE_FILE=secrets/hcp_cookie.txt
HCP_PAGE_SIZE=80
HCP_BACKFILL_DAYS=210
HCP_DELAY_LIST=1.5
HCP_DELAY_DOWNLOAD=1.0

# PostgreSQL (совпадает с docker-compose.yml)
PG_HOST=localhost
PG_PORT=5439
PG_USER=hcp
PG_PASSWORD=change_me_local_only
PG_DB=hcp_calls

DATA_DIR=data
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=