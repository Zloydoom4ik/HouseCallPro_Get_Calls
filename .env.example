# Скопируй этот файл в .env и заполни. .env в git не коммитится.

# --- Housecall Pro ---
HCP_BASE_URL=https://pro.housecallpro.com
HCP_COOKIE_FILE=secrets/hcp_cookie.txt
HCP_PAGE_SIZE=80
# Сколько дней истории тянуть при первом полном проходе (записи старше ~6 мес всё равно удалены):
HCP_BACKFILL_DAYS=210
# Паузы между запросами, сек (не уменьшать без причины — бережём их сервер):
HCP_DELAY_LIST=1.5
HCP_DELAY_DOWNLOAD=1.0

# --- Хранилище ---
DATA_DIR=data
DB_PATH=data/hcp_calls.db

# --- Уведомления в Telegram (необязательно; оставь пустым, чтобы писать только в консоль) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
